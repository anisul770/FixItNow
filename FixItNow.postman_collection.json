{
  "info": {
    "_postman_id": "6e39d43d-ded6-49a9-8bd9-87a6fe279911",
    "name": "FixItNow",
    "description": "Complete REST API reference for the FixItNow backend, generated from the Express routes/controllers so the frontend has an accurate contract to build against.\n\nSeeded demo accounts (all password `1234`):\n- Admin: abc@gmail.com\n- Technician: abc8@gmail.com / abc9@gmail.com\n- Customer: abc1@gmail.com .. abc7@gmail.com\n\nAuth: log in with the **Auth > Login** request first. It stores the returned `access_token`/`refresh_token` as collection variables automatically, and every other request (except the ones marked \"No Auth\") sends `Authorization: Bearer {{access_token}}`. The API also accepts an `accessToken` httpOnly cookie, which Postman's cookie jar will pick up from the Login response as well.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "54851279"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "https://fix-it-now-tau.vercel.app", "description": "From APP_URL in .env" },
    { "key": "access_token", "value": "", "description": "Set automatically by Auth > Login / Refresh Token" },
    { "key": "refresh_token", "value": "", "description": "Set automatically by Auth > Login" },
    { "key": "categoryId", "value": "", "description": "Category id, e.g. from Category > Get All Categories" },
    { "key": "serviceId", "value": "", "description": "Service id, e.g. from Service > Get All Services" },
    { "key": "technicianId", "value": "", "description": "TechnicianProfile id (not the User id) - from Technician > Get All Technicians" },
    { "key": "userId", "value": "", "description": "User id - from Admin > Get All Users" },
    { "key": "bookingId", "value": "", "description": "Booking id - from Booking > Create New Booking / Get My Bookings" },
    { "key": "slotId", "value": "", "description": "Availability slot id - from Technician > Get My Slots" },
    { "key": "reviewId", "value": "", "description": "Review id - from Review > Get My Reviews" },
    { "key": "val_id", "value": "", "description": "SSLCommerz validation id, sent by the gateway on the success callback" }
  ],
  "item": [
    {
      "name": "Home",
      "request": {
        "auth": { "type": "noauth" },
